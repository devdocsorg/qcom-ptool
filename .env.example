# Environment settings read by qcom-ptool and its Makefile. Nothing loads this
# file: export a setting in the shell, or pass a make variable on the command
# line (make all BUILD_ID=0001), which takes precedence over the environment.
# The configuration reference in docs/source/user/CONFIGURATION.md describes them.

# Optional string read by "qcom-ptool ptool". When set, it seeds the random disk
# and partition GUIDs so repeated builds produce identical files; CI and
# tests/integration/checksums.sha256 use qcom-ptool-ci. Unset: new random GUIDs.
PTOOL_SEED=qcom-ptool-ci

# Optional command the root Makefile runs for each generator. Default: qcom-ptool
# found on PATH. Use an absolute path, because the gpt rule runs it from each
# layout folder.
QCOM_PTOOL=/usr/local/bin/qcom-ptool

# Optional build identifier the root Makefile passes to "gen_contents -b"; it is
# written to every <build_id> element of contents.xml. Unset: empty elements.
BUILD_ID=0001
