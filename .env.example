# qcom-ptool does not read this file. Export a setting in your shell or pass it
# to make, for example: PTOOL_SEED=qcom-ptool-ci make all
# The configuration reference in docs/source/user/CONFIGURATION.md lists them too.

# Optional string read by ptool. Seeds the random disk and partition GUIDs so
# output is reproducible. Unset: GUIDs are random. CI and the checksum manifest
# use qcom-ptool-ci.
PTOOL_SEED=qcom-ptool-ci

# Optional make variable: the command the Makefile runs. ptool runs inside each
# platform folder, so use a command on PATH or an absolute path.
# Unset: qcom-ptool from PATH.
QCOM_PTOOL=qcom-ptool

# Optional make variable: build ID that gen_contents writes to contents.xml.
# Unset or empty: no build ID.
BUILD_ID=
